# Runtime
APP_ENV=production
LOG_LEVEL=INFO
ENV_FILE=.env.local

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=voice-tutor

# OpenAI / LangChain tutor
OPENAI_API_KEY=
TUTOR_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=10
LLM_TOTAL_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=350
MAX_LLM_CALLS_PER_TURN=3
GRAPH_RECURSION_LIMIT=8

# Qdrant private knowledge
ENABLE_RETRIEVAL=true
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_TEXT_FIELD=text
QDRANT_TIMEOUT_SECONDS=3
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=5
RETRIEVER_TIMEOUT_SECONDS=9
RETRIEVER_TOP_K=5
# 0 disables the threshold. Tune this using real evaluation questions.
RETRIEVER_MIN_SCORE=0.0
RETRIEVER_MAX_CONTEXT_CHARS=10000

# Tavily current web information
ENABLE_WEB_SEARCH=true
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=6
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_MAX_CONTEXT_CHARS=6000
WEB_SEARCH_DEPTH=basic

# Per-room tool-result memory
SESSION_CACHE_TTL_SECONDS=600
SESSION_CACHE_MAX_ENTRIES=20
SESSION_REFERENCE_CONTEXT_CHARS=7000
ENABLE_TOOL_STATUS_MESSAGES=true

# Voice models
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash

# Audio and turn handling
ENABLE_NOISE_CANCELLATION=true
ENDPOINTING_MODE=fixed
ENDPOINTING_MIN_DELAY=0.5
ENDPOINTING_MAX_DELAY=3.0
INTERRUPTION_MODE=adaptive
INTERRUPTION_MIN_DURATION=0.5
INTERRUPTION_MIN_WORDS=0
RESUME_FALSE_INTERRUPTION=true
PREEMPTIVE_GENERATION_ENABLED=true
# Keep false until overlap and interruption testing passes in staging.
PREEMPTIVE_TTS_ENABLED=false
PREEMPTIVE_MAX_SPEECH_DURATION=8
PREEMPTIVE_MAX_RETRIES=2
